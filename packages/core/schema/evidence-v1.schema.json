{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ent.evidence/v1"
    },
    "repo": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$"
    },
    "pr": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "check_definition_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "checker_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "enum": [
              "E1",
              "E2",
              "E3",
              "E4"
            ]
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skip",
              "quarantined"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "fix_hint": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "layer",
          "rule_id",
          "status",
          "location",
          "fix_hint"
        ],
        "additionalProperties": false
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "before": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "new_skips": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "before",
        "after",
        "new_skips"
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "properties": {
        "types_changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshots_changed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "types_changed",
        "snapshots_changed"
      ],
      "additionalProperties": false
    },
    "holdout": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "matched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "review_stage": {
              "type": "string",
              "enum": [
                "all",
                "sample",
                "none"
              ]
            }
          },
          "required": [
            "matched",
            "passed",
            "review_stage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vendor": {
              "type": "string",
              "minLength": 1
            },
            "verdict": {
              "type": "string",
              "enum": [
                "approve",
                "request_changes",
                "unavailable"
              ]
            }
          },
          "required": [
            "vendor",
            "verdict"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "repo",
    "pr",
    "head_sha",
    "base_sha",
    "check_definition_sha",
    "checker_sha",
    "level",
    "results",
    "tests",
    "surface",
    "holdout",
    "review",
    "generated_at"
  ],
  "additionalProperties": false
}
