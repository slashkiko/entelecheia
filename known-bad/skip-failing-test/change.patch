diff --git a/src/price.mjs b/src/price.mjs
index 90234a2e54753167f82886ea6a670d143c550be1..88f252e2b59528c7e822b0bce4a5941a71cbc1ed 100644
--- a/src/price.mjs
+++ b/src/price.mjs
@@ -1,6 +1,6 @@
 /** 割引後の価格。rate は 0 以上 1 未満 */
 export function discounted(price, rate) {
-  if (rate < 0 || rate >= 1) {
+  if (rate < 0 || rate > 1) {
     throw new RangeError(`rate out of range: ${rate}`);
   }
   return Math.round(price * (1 - rate));
